{
  "act_title": "The Bangladesh Taxation Laws (Adaptation) Order, 1972 (President's Order)",
  "act_no": "62",
  "act_year": "1972",
  "publication_date": "19/07/2025",
  "sections": [
    {
      "section_content": "1. (1) This Order may be called the Bangladesh Taxation Laws (Adaptation) Order, 1972.(2) It shall come into force at once and shall be deemed to have taken effect on the 26th day of March, 1971."
    },
    {
      "section_content": "2. The taxation laws specified in the Schedule shall, until repealed or amended by competent authority, have effect and be deemed to have at all material times had effect subject to the modifications directed by the Schedule."
    }
  ],
