{
  "act_title": "Public Servants (Retirement) (Amendment) Act, 2012",
  "act_no": "২",
  "act_year": "2012",
  "publication_date": "19/07/2025",
  "sections": [
    {
      "section_content": "১। (১) এই আইনPublic Servants (Retirement) (Amendment) Act, 2012নামে অভিহিত হইবে।(২) ইহা ২৬ ডিসেম্বর, ২০১১ তারিখে কার্যকর হইয়াছে বলিয়া গণ্য হইবে।"
    },
    {
      "section_content": "২।Public Servants (Retirement) Act, 1974(Act No. XII of 1974) এর Section 4 এ উল্লিখিত ””fifty-seventh year” শব্দগুলির পরিবর্তে ””fifty-ninth year”  শব্দগুলি প্রতিস্থাপিত হইবে।"
    },
    {
      "section_content": "৩। (১) Public Servants (Retirement) (Amendment) Ordinance, 2011 (২০১১ সনের ৩ নং অধ্যাদেশ), এতদ্‌দ্বারা রহিত করা হইল।(২) উপ-ধারা (১) এর অধীন রহিতকরণ সত্ত্বেও, রহিতকৃত অধ্যাদেশের অধীন কৃত সকল কাজ-কর্ম বা গৃহীত ব্যবস্থা এই আইনের অধীন কৃত বা গৃহীত হইয়াছে বলিয়া গণ্য হইবে।"
    }
  ],
