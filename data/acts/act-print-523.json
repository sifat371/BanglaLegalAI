{
  "act_title": "The Appropriation (Supplementary) Ordinance, 1976",
  "act_no": "XLVI",
  "act_year": "1976",
  "publication_date": "19/07/2025",
  "sections": [
    {
      "section_content": "1. This Ordinance may be called theAppropriation (Supplementary) Ordinance, 1976."
    },
    {
      "section_content": "2. There may be paid and applied from and out of the Consolidated Fund sums not exceeding those specified in Column 3 of the Schedule amounting in the aggregate to the sum of Taka six hundred sixty-five crores, thirty-three lakhs and ninety-four thousand towards defraying the several charges which will come in course of payment during the financial year ending on the thirtieth day of June, 1976, in respect of the services and purposes specified in Column 2 of the Schedule."
    },
    {
      "section_content": "3. The sums authorised to be paid and applied from and out of the Consolidated Fund by this Ordinance shall be appropriated for the services and purposes expressed in the Schedule in relation to the financial year ending on the thirtieth day of June, 1976."
    }
  ],
