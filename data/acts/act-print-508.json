{
  "act_title": "The Registration (Extension of Limitation) Ordinance, 1975",
  "act_no": "LX",
  "act_year": "1975",
  "publication_date": "19/07/2025",
  "sections": [
    {
      "section_content": "1. This Ordinance may be called theRegistration (Extension of Limitation) Ordinance, 1975."
    },
    {
      "section_content": "2. Where the period within which any document already presented for registration but could not be admitted to registration or any appeal or application already filed but could not be disposed of, by a Sub-Registrar or Registrar under any provision of theRegistration Act, 1908(XVI of 1908) expired at any time after the 1st day of March, 1971 and before the 1st day of March, 1972, such document, appeal or application may be registered or disposed of, notwithstanding anything contained in that Act or in any other law for the time being in force, within eight months from the date of commencement of this Ordinance."
    }
  ],
