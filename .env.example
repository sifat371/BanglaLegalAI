# Mistral AI API Key
# Get yours at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# HuggingFace API Key (for embeddings)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Experimental claim-level source support verification
ENABLE_CLAIM_SUPPORT_VERIFICATION=true
CLAIM_SUPPORT_MAX_CLAIMS=12

# Stage 5 grounding enforcement
ENABLE_ANSWER_REPAIR=true
ANSWER_REPAIR_MAX_ATTEMPTS=1
FAIL_CLOSED_ON_GROUNDING_FAILURE=true
